%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 592ea5e647e7f5046b46abe167b48835, type: 3}
  m_Name: Catalog
  m_EditorClassIdentifier: Assembly-CSharp::TGJ.StoryCatalog
  content:
    nodes:
    - id: Prologue
      lines:
      - "\u201C\u5916\u90E8\u4E16\u754C\u5728\u6F20\u7136\u6027\u7684\u6CD5\u5219\u4E0B\u53F9\u606F\u2026\u2026\u201D\n\n\u2014\u2014\u514B\u5C14\u51EF\u90ED\u5C14"
    - id: Wake
      lines:
      - "\u4F60\uFF08\u4E3B\u89D2\uFF09\u72EC\u767D(\u4E0D\u5C0F\u5FC3\u5728\u5019\u573A\u65F6\u7761\u7740\u60CA\u9192)\uFF1A\u6211\u600E\u4E48\u4F1A\u5728\u8FD9\u91CC\u9192\u6765\uFF1F"
      - "\u65C1\u767D\uFF1A\u6DE1\u6DE1\u7684\uFF0C\u9065\u8FDC\u7684\u5BBF\u9189\u8FD8\u5728\u4F60\u7684\u8111\u6D77\u91CC\u6643\u8361\u7740\u5FAE\u5FAE\u523A\u75DB\u7684\u6CE2\u7EB9\uFF0C\u795E\u7ECF\u672B\u68A2\u4E00\u6EF4\u4E00\u6EF4\u4F20\u6765\u949F\u58F0\u4E00\u6837\u7684\u6218\u6817\uFF0C\u7C97\u7CD9\u3001\u9EBB\u6728\u3001\u8FDF\u949D\uFF0C\u6709\u5982\u78E8\u635F\u4E25\u91CD\u7684\u7EF3\u7D22\u7EA4\u7EF4\uFF0C\u201C\u5373\u4FBF\u518D\u5E74\u8F7B\u4E2A\u4E94\u516D\u5C81\u4E5F\u4E0D\u4F1A\u662F\u8FD9\u6837\u2026\u2026\u201D\u8FD9\u5FF5\u5934\u4E0D\u65E0\u6839\u636E\u5730\u5728\u5FC3\u5934\u98D8\u8FC7\u3002"
      - "\u5F53\u4F60\u610F\u8BC6\u5230\u5468\u56F4\u7684\u5608\u6742\u65F6\uFF0C\u4EBA\u7FA4\u7684\u566A\u97F3\u5176\u5B9E\u5DF2\u7ECF\u975E\u5E38\u96BE\u4EE5\u5FCD\u53D7\u4E86\uFF0C\u4E0D\u8FC7\u5373\u4F7F\u662F\u5728\u4EBA\u5934\u6512\u52A8\u7684\u5927\u5385\u91CC\uFF0C\u4F60\u4E5F\u51FA\u4E8E\u865A\u5F31\u4E0B\u610F\u8BC6\u88F9\u7D27\u4E86\u4E0A\u8863\u3002"
      - "\u4F60\u6CE8\u610F\u5230\u4E00\u4E2A\u9ED1\u8272\u7684\u630E\u5305\u6B63\u6401\u5728\u811A\u8FB9\uFF0C\u4E00\u5C42\u71E0\u70ED\u7684\u7EC6\u6C57\u7C98\u5728\u548C\u630E\u5305\u8D34\u5408\u7684\u5C0F\u817F\u4E0A\u3002"
    - id: Bag0
      lines:
      - "\u4E00\u90E8\u7FFB\u76D6\u624B\u673A"
    - id: Bag1
      lines:
      - "\u97F3\u4E50\u4F1A\u95E8\u7968\uFF0C\u4E0A\u6709A\u7684\u7B7E\u540D"
    - id: Bag2
      lines:
      - "\u4E00\u672C\u5D2D\u65B0\u7684\u97F3\u4E50\u6742\u5FD7"
    - id: Bag3
      lines:
      - "\u94B1\u5305"
    - id: Bag4
      lines:
      - "\u6D88\u6BD2\u9152\u7CBE"
    - id: Bag5
      lines:
      - "\u4E00\u67C4\u94A5\u5319\uFF0C\u94A5\u5319\u73AF\u4E0A\u5957\u7740\u5199\u6709\u623F\u95F4\u53F7\u7684\u5C0F\u5361\u7247"
    - id: Bag6
      lines:
      - "\u4E00\u672C\u65E7\u4E66\uFF0C\u300A\u675C\u4F0A\u8BFA\u54C0\u6B4C\u300B\u6249\u9875\u4E0A\u6709\u6DE1\u6DE1\u7684\u5B57\u8FF9\uFF0C\u4E09\u4E2A\u4EBA\u7684\u7B7E\u540D\uFF08\u4E3B\u89D2\u548CAB\uFF09"
    - id: PhoneIntro
      lines:
      - "\u65C1\u767D\uFF1A\u97F3\u4E50\u4F1A\u5417\uFF1F\u4F60\u662F\u654F\u611F\u5230\u613F\u610F\u5728\u8FD9\u79CD\u5730\u65B9\u5F85\u4E0B\u53BB\u7684\u4EBA\u5417\uFF1F\u5F88\u660E\u663E\u4E00\u79CD\u964C\u751F\u4E0D\u5B89\u7684\u8E81\u52A8\u5728\u9A9A\u6270\u4F60\uFF0C\u5468\u56F4\u586B\u6EE1\u4E86\u4E0D\u719F\u6089\u7684\u9762\u5B54\uFF0C\u5982\u679C\u8981\u7A7F\u8FC7\u5EA7\u6905\u79BB\u5F00\uFF0C\u5C31\u5F97\u7ED9\u597D\u51E0\u4E2A\u964C\u751F\u4EBA\u9053\u6B49\u884C\u793C\u2026\u2026\u90A3\u66F4\u662F\u8BA9\u4EBA\u4E0D\u5BD2\u800C\u6817\u554A\u2026\u2026\u8FD9\u79CD\u7B49\u5F85\uFF0C\u8FD9\u79CD\u53EF\u601C\u7684\u597D\u5947\uFF0C\u771F\u662F\u8BA9\u4F60\u2026\u2026"
      - "\u60B2\u54C0"
      - "\u6B63\u662F\u8FD9\u4E2A\uFF0C\u8FD9\u6D0B\u6EA2\u7740\u65E0\u6BD4\u5145\u88D5\u7684\u719F\u6089\u611F\u7684\u6076\u5FC3\u4E1C\u897F\uFF0C\u4E0D\u662F\u5417\uFF0C\u8BA9\u4F60\u538C\u5026\u3001\u75B2\u60EB\uFF0C\u4F46\u53C8\u5E26\u6765\u5341\u8DB3\u9ECF\u7A20\u7684\u638C\u63A7\u611F\uFF0C\u8FD9\u79CD\u53EF\u601C\u4E4B\u4EBA\u9A84\u50B2\u7684\u6B22\u5FEB\uFF0C\u7A7F\u5728\u4F60\u8EAB\u4E0A\u518D\u5408\u8EAB\u4E0D\u8FC7\u4E86\u2026\u2026"
      - "\u4F60\u60F3\u6446\u8131\u5B83\uFF0C\u54C8\u54C8\uFF0C\u4F60\u771F\u7684\u8FD8\u4EE5\u4E3A\u4F60\u80FD\u505A\u5230\u5417\uFF1F"
      - "\u6389\u8FDB\u7CD6\u6D46\u7F50\u91CC\u7684\u86C6\u866B\uFF0C\u793C\u8282\u6027\u5730\u7FFB\u817E\u4E24\u4E0B\u4E4B\u540E\uFF0C\u4E0D\u5C31\u6B23\u559C\u5815\u843D\u5730\u6C89\u6EBA\u5728\u751C\u871C\u7684\u7A92\u606F\u4E2D\u592E\u4E86\u5417\uFF1F"
      - "\u7535\u8BDD\u94C3\u58F0\u54CD\u8D77"
      - "\u4F60\u88AB\u5413\u4E86\u4E00\u8DF3"
      - "\u51E0\u4E2A\u5468\u56F4\u6295\u6765\u7684\u660E\u77E5\u6545\u95EE\u7684\u6D88\u9063\u773C\u795E\u8BA9\u4F60\u9690\u9690\u6124\u6012\u3002"
      - "\u4F60\u4FEF\u4E0B\u8EAB\u5B50\u63A5\u8D77\u7535\u8BDD"
      - "\u5973\u4E3B\uFF08\u7535\u8BDD\u4E2D\uFF09\uFF08\u6E38\u620F\u91CC\u8FD9\u91CC\u6682\u4E14\u5199\u505A\u201C\u5973\u58F0\u201D\uFF09\uFF1A\u6F14\u51FA\u5F00\u59CB\u4E86\u5417\uFF1F"
      - "\u65C1\u767D\uFF1A\u5E74\u8F7B\u5973\u5B50\u7684\u58F0\u97F3\uFF0C\u53E3\u543B\u81EA\u7136\uFF0C\u4EFF\u4F5B\u975E\u5E38\u719F\u7EDC\u2014\u2014\u4F60\u8FD8\u548C\u8FD9\u6837\u7684\u4EBA\u6709\u63A5\u89E6\u5417\uFF1F"
      - "\u4F60\uFF1A\u6CA1\u6709\uFF0C\u8FD8\u5728\u5019\u573A\uFF0C\u4F60\u2014\u2014\uFF08\u4F60\u4E5F\u6000\u7740\u5C0F\u5C0F\u7684\u6076\u4F5C\u5267\u5FC3\u7406\u4F7F\u7528\u7A00\u677E\u5E73\u5E38\u7684\u8BED\u6C14\uFF09"
      - "\u5973\u58F0\uFF1A\u55EF\uFF0C\u4F60\u80FD\u4E0D\u80FD\u5E2E\u6211\u627E\u627E\u4E00\u4E2A\uFF0C\u55EF\uFF0C\u53EB\u201C\u54F2\u5B66\u5BB6\u201D\u7684\u4EBA\uFF0C\u4ED6\u5C31\u5728\u97F3\u4E50\u5385\u91CC\u3002"
      - "\uFF08\u5979\u8BF4\u8BDD\u65F6\u5E26\u6709\u6545\u4F5C\u9547\u5B9A\u7684\u5598\u6C14\u58F0\u592A\u660E\u663E\u4E86\uFF09"
      - "\u4F60\uFF1A\u54F2\u5B66\u5BB6\uFF1F\uFF08\u4F60\u7684\u54C2\u7B11\u58F0\u751A\u81F3\u4F20\u5230\u4E86\u73B0\u5B9E\u4E16\u754C\u4E2D\uFF09\u8FD9\u4E48\u591A\u4EBA\u91CC\u6050\u6015\u4E0D\u597D\u627E\u2026\u2026"
      - "\u5973\u58F0\uFF1A\u54CE\u5440\uFF0C\u4F60\u76F4\u63A5\u7AD9\u8D77\u6765\u53EB\u4E00\u58F0\u54F2\u5B66\u5BB6\uFF0C\u641E\u4E0D\u597D\u90A3\u4EBA\u5C31\u8FC7\u6765\u627E\u4F60\u4E86\u3002"
      - "\u4F60\uFF1A\u4F60\u5230\u5E95\u60F3\u5E72\u561B\uFF1F"
      - "\u5973\u58F0\uFF1A\uFF08\u5979\u6309\u637A\u4E0D\u4F4F\u52A0\u5FEB\u4E86\u8BED\u901F\uFF0C\u6709\u4E9B\u614C\u5F20\uFF09\u542C\u7740\uFF0C\u4F60\u8981\u662F\u627E\u5230\u4E86\u4EBA\uFF0C\u5C31\u8BF4\uFF0C\u989D\uFF0C\u201C\u540E\u95E8\u7684\u706B\u82D7\u5C31\u8981\u7184\u706D\u4E86\u201C\u3002"
      - "\u4F60\uFF1A\u8BF4\u5230\u5E95\u6211\u4E3A\u4EC0\u4E48\u8981\u5E2E\u4F60\u627E\u4EBA\u5462\uFF1F"
      - "\u5973\u58F0\uFF1A\u54C8\u54C8\u54C8\uFF0C\u4E5F\u6CA1\u4EC0\u4E48\uFF0C\u4F60\u5C31\u548C\u6211\u7238\u597D\u597D\u65C5\u6E38\u5427\uFF0C\u4F60\u8981\u662F\u613F\u610F\u5E2E\u5FD9\uFF0C\u4E5F\u53EA\u4F1A\u8BA9\u6211\u5F88\u611F\u8C22\u4F60\u800C\u5DF2\u3002\uFF08\u5979\u4F3C\u4E4E\u6CE8\u610F\u5230\u81EA\u5DF1\u5148\u524D\u7684\u5931\u6001\uFF0C\u968F\u5373\u62FF\u51FA\u4E86\u6F2B\u4E0D\u7ECF\u5FC3\u7684\u9762\u5B54\uFF09"
      - "\u65C1\u767D\uFF1A\u5979\u7238\u7238\uFF0C\u662F\u4F60\u7684\u540C\u4F34\u5417\uFF1F\u539F\u6765\u4F60\u8FD9\u79CD\u4EBA\u7ADF\u7136\u8FD8\u6CA1\u6709\u6CA6\u843D\u5230\u5B64\u8EAB\u4E00\u4EBA\u7684\u5730\u6B65\u3002"
      - "\uFF08\u73AF\u89C6\u4E00\u5468\uFF0C\u4F3C\u4E4E\u6CA1\u4EBA\u8981\u8DDF\u4F60\u642D\u8BDD\u3002\u867D\u7136\u540E\u6392\u5EA7\u4F4D\u5927\u591A\u8FD8\u7A7A\u7740\uFF0C\u4F46\u662F\u663E\u7136\u6F14\u51FA\u8981\u5F00\u59CB\u4E86\uFF09"
    - id: Phone0
      lines:
      - "\u4F60\uFF1A\u5BF9\u4E0D\u8D77\u4E86\uFF0C\u5C0F\u59D0\uFF0C\u867D\u7136\u6211\u4E5F\u95F2\u5F97\u65E0\u6240\u4E8B\u4E8B\uFF0C\u4F46\u6211\u53EF\u6CA1\u7A7A\u966A\u4F60\u65E0\u7406\u53D6\u95F9\uFF0C\u6216\u8005\u4F60\u613F\u610F\u8BB2\u8BB2\u2014\u2014\u4F60\u7238\u7238\u7684\u4E8B\uFF1F"
      - "\u5973\u58F0\uFF1A\u8FD8\u6CA1\u542C\u591F\u5417\uFF1F\u4E0D\u8FC7\u73B0\u5728\u53EF\u6765\u4E0D\u53CA\uFF0C\u4EE5\u540E\u518D\u89C1\u9762\u7684\u8BDD\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u968F\u4FBF\u95EE\u561B\u3002"
      - "\u4F60\uFF1A\u201C\u54F2\u5B66\u5BB6\u201D\u7684\u4E8B\u60C5\u770B\u6765\u5F88\u91CD\u8981\u54AF\uFF1F\u6211\u770B\u4F60\u4E00\u5E45\u60F3\u8981\u5C3D\u5FEB\u7ED3\u675F\u8C08\u8BDD\u7684\u6837\u5B50\u3002"
      - "\u5973\u58F0\uFF1A\u6211\u53EF\u4E0D\u662F\u5728\u8BF7\u6C42\u4F60\u54E6\uFF0C\u4E00\u5207\u770B\u4F60\u5FC3\u60C5\uFF0C\u8FD9\u4E8B\u4E5F\u6CA1\u4EC0\u4E48\u5927\u4E0D\u4E86\u7684\u3002"
      - "\uFF08\u542C\u5230\u5979\u8FD9\u4E48\u8BF4\uFF0C\u4F60\u4E0D\u7531\u5F97\u60F3\uFF0C\u5979\u7684\u610F\u601D\u5176\u5B9E\u662F\uFF0C\u201C\u6211\u4EEC\u518D\u4E5F\u4E0D\u89C1\u201D\uFF09"
    - id: Phone1
      lines:
      - "\u4F60\uFF1A\u90A3\u597D\u5427\uFF0C\u6211\u53EF\u4EE5\u8BD5\u8BD5\uFF0C\u4E0D\u8FC7\uFF0C\u4F60\u5F97\u5148\u544A\u8BC9\u6211\u6211\u7684\u540D\u5B57\u3002"
      - "\u5973\u58F0\uFF1A\u4F60\u5728\u8BF4\u4EC0\u4E48\uFF1F\u4F60\u7684\u540D\u5B57\uFF1F\u4F60\u628A\u5B83\u4E5F\u641E\u4E22\u5728\u4F60\u8F7B\u63CF\u6DE1\u5199\u7684\u81EA\u6211\u6000\u7591\u91CC\u9762\u4E86\u5417\uFF1F\u55EF\uFF0C\u4E0D\u8FC7\u8FD9\u4E5F\u50CF\u4F60\u5E72\u7684\u4E8B\u60C5\u3002\u6211\u8981\u662F\u73B0\u5728\u968F\u4FBF\u7ED9\u4F60\u53D6\u4E2A\u540D\u5B57\uFF0C\u4F60\u4F1A\u4E0D\u4F1A\u5F53\u771F\u5450\uFF1F\u54C8\u54C8\u54C8\u3002"
      - "\u4F60\uFF1A\u5982\u679C\u4F60\u613F\u610F\u597D\u597D\u544A\u8BC9\u6211\u540D\u5B57\uFF0C\u6211\u4E5F\u4F1A\u5F88\u611F\u8C22\u4F60\u54E6\u3002"
    - id: Named
      lines:
      - "\u5973\u58F0\uFF1A\u4F60\u5BF9\u5B83\u4E0D\u6EE1\u610F\u6211\u4E5F\u65E0\u80FD\u4E3A\u529B\uFF0C\u6BCF\u4E2A\u4EBA\u6389\u8FDB\u8FD9\u7A84\u7A84\u7684\u5BC6\u5C01\u888B\u91CC\uFF0C\u4E0D\u7BA1\u6709\u6CA1\u6709\u610F\u8BC6\u5230\uFF0C\u5176\u5B9E\u90FD\u6709\u6028\u6C14\u5427\u3002\u6CA1\u65F6\u95F4\u548C\u4F60\u95F2\u804A\u4E86\u2014\u2014\u540C\u6837\u7684\u95EE\u9898\uFF0C\u4F60\u4E3A\u4EC0\u4E48\u4E0D\u95EE\u95EE\u54F2\u5B66\u5BB6\u5462\uFF1F"
    - id: Phone2
      lines:
      - "\u4F60\uFF1A\u4F60\u7238\u7238\u73B0\u5728\u53EF\u4E0D\u5728\u6211\u8EAB\u8FB9\uFF0C\u4F60\u77E5\u9053\u4ED6\u5728\u4EC0\u4E48\u4F4D\u7F6E\u5417\uFF1F\uFF08\u4F60\u53EF\u4E0D\u60F3\u60F9\u9EBB\u70E6\uFF0C\u6A21\u68F1\u4E24\u53EF\u7684\u95EE\u6CD5\u6B64\u65F6\u6B64\u523B\u6070\u5230\u597D\u5904\uFF09"
      - "\u5973\u58F0\uFF1A\u4F60\u662F\u6307\u2014\u2014\u54E6\uFF0C\u4ED6\u6CA1\u7ED9\u4F60\u8BB2\u5417\uFF0C\u54C8\u54C8\u54C8\uFF0C\u4ED6\u5373\u4FBF\u5728\u8FD9\u79CD\u5C0F\u6F14\u51FA\u91CC\u4E5F\u662F\u8FDC\u8FDC\u6DF7\u4E0D\u4E0A\u9996\u5E2D\u7684\uFF0C\u641E\u4E0D\u597D\u4ED6\u8FD8\u5F97\u5E2E\u5FD9\u7ED9\u4EBA\u7FFB\u9875\u5450\u3002"
      - "\u4F60\uFF1A\u6211\u8FD8\u662F\u5F88\u671F\u5F85\u4F60\u7238\u7238\u7684\u6F14\u51FA\u7684\u3002"
      - "\u5973\u58F0\uFF1A\u600E\u4E48\uFF1F\u4F60\u5BF9\u4ED6\u8FD8\u8981\u5949\u627F\u5417\uFF1F\u8FD8\u662F\u8BF4\uFF0C\u72EC\u5904\u4E2A\u4E24\u4E09\u5929\u4E0B\u6765\uFF0C\u4F60\u5C31\u88AB\u4ED6\u6ED4\u6ED4\u4E0D\u7EDD\u7684\u5439\u5618\u552C\u5F97\u9ED1\u767D\u4E0D\u5206\u4E86\uFF1F"
      - "\u4F60\uFF1A\u6211\u8FD8\u662F\u60F3\u8981\u7EF4\u7CFB\u4E00\u4E0B\u522B\u4EBA\u6B63\u5E38\u7684\u7236\u5973\u5173\u7CFB\u561B\u3002"
      - "\u5973\u58F0\uFF1A\u4F60\u53EF\u522B\u9017\u6211\u7B11\u4E86\u3002\u5BF9\u4E86\uFF0C\u6211\u8FD8\u86EE\u597D\u5947\u7684\uFF0C\u4ED6\u8981\u662F\u8FD8\u6253\u4E86\u90A3\u6761\u82B1\u82B1\u7EFF\u7EFF\u7684\u4E11\u9886\u5E26\uFF0C\u4F60\u53EF\u5F97\u7ED9\u6211\u62CD\u5F20\u7167\u7559\u7740\u3002"
      - "\u4F60\uFF1A\u518D\u8BF4\u5427\u3002"
    - id: Phone3
      lines:
      - "\u4F60\uFF1A\u540E\u95E8\u7684\u706B\u82D7\u662F\u4EC0\u4E48\u4E1C\u897F\uFF1F"
      - "\u5973\u58F0\uFF1A\u548C\u6D77\u5CB8\u7684\u706F\u5854\u3001\u4E1B\u6797\u4E2D\u7684\u516C\u8DEF\u3001\u5B87\u5B99\u91CC\u7684\u592A\u7A7A\u7AD9\u4E00\u6837\uFF0C\u90FD\u662F\u770B\u5230\u4E86\u5C31\u4F1A\u76F8\u4FE1\u7684\u4E1C\u897F\uFF0C\u61C2\u4E86\u5417\uFF1F"
      - "\u4F60\uFF1A\u90A3\u4E48\u8BF4\u5B83\u7184\u706D\u4E86\uFF0C\u5C31\u662F\u5E0C\u671B\u6D88\u5931\u7684\u610F\u601D\u54AF\uFF1F"
      - "\u5973\u58F0\uFF1A\u4FE1\u4EFB\u7684\u65F6\u5019\uFF0C\u4E5F\u4E0D\u592A\u9700\u8981\u5E0C\u671B\u561B\u3002"
      - "\u4F60\uFF1A\u90A3\u4F60\u6050\u6015\u4E0D\u592A\u76F8\u4FE1\u8FD9\u4E2A\u54F2\u5B66\u5BB6\u5427\u3002"
      - "\u5973\u58F0\uFF1A\u4F60\u8BF4\u8BDD\u592A\u70E6\u4EBA\u4E86\uFF0C\u628A\u90A3\u53E5\u8BDD\u4F20\u8FBE\u51FA\u53BB\uFF0C\u597D\u5417\uFF1F"
    - id: AudienceLead
      lines:
      - "\u65C1\u767D\uFF1A\u4F60\u4F1A\u5E2E\u5FD9\u5417\uFF1F\u51ED\u501F\u4F60\u90A3\u70B9\u865A\u4F2A\u7684\u2014\u2014\u70ED\u5FC3\uFF1F"
      - "\u7AD9\u8D77\u6765\u5927\u58F0\u547C\u558A\u8FD9\u79CD\u4E8B\u60C5\u6839\u672C\u4E0D\u53EF\u80FD\u53D1\u751F\u5728\u4F60\u7684\u4E16\u754C\u4E2D\uFF0C\u201C\u5373\u4FBF\u662F\u4E3A\u4E86\u6211\u81EA\u5DF1\u201D\uFF0C\u4F60\u4E0D\u6B63\u5728\u8FD9\u4E48\u60F3\u5417\uFF1F\u90A3\u5973\u5B69\u4EE5\u4E3A\u5979\u51ED\u501F\u7740\u9752\u6625\u5962\u534E\u7684\u53F7\u53EC\u529B\uFF0C\u5C31\u80FD\u9A71\u4F7F\u4F60\u8FD9\u65E0\u7A77\u81EA\u604B\u7684\u61D2\u4EBA\u5417\uFF1F\u4F60\u5632\u7B11\u5979\u4E5F\u5C31\u662F\u5728\u5632\u7B11\u81EA\u5DF1\u54E6\u3002"
      - "\u5176\u5B9E\u4E5F\u6709\u6298\u4E2D\u7684\u529E\u6CD5\u3002"
      - "\u9047\u5230\u662F\u975E\u5206\u660E\u548C\u9053\u5FB7\u8003\u9A8C\u7684\u65F6\u523B\u4F60\u6700\u64C5\u957F\u8FD9\u4E48\u529E\u4E86\u3002"
      - "\u201C\u5979\u8BF4\u8D77\u8BDD\u6765\u660E\u663E\u662F\u6211\u719F\u6089\u7684\u4EBA\u2026\u2026\u201D\u8FD9\u4EFD\u719F\u6089\uFF0C\u4F60\u4E0D\u6562\u591A\u60F3\u4E86\u5417\uFF1F"
      - "\u5468\u56F4\u8FD1\u5904\u4E00\u5708\u89C2\u4F17\uFF0C\u6216\u6C89\u9ED8\u6216\u8BF4\u7B11\uFF0C\u201C\u54F2\u5B66\u5BB6\u201D\u4F1A\u4E0D\u4F1A\u5C31\u5728\u91CC\u9762\u5462\uFF1F\u7528\u4E0D\u6253\u6270\u5230\u7B2C\u4E09\u4E2A\u4EBA\u7684\u97F3\u91CF\uFF0C\u602F\u751F\u751F\u8BE2\u95EE\u4E00\u4E24\u6B21\uFF0C\u4F3C\u4E4E\u662F\u80FD\u8BA9\u4F60\u6DEB\u8361\u7684\u9AD8\u5C1A\u81EA\u5C0A\u79F0\u5FC3\u5982\u610F\u7684\u505A\u6CD5\u3002"
    - id: AudienceA
      lines:
      - "\u4F60\uFF08\u8F6C\u8FC7\u5934\u8BD5\u63A2\u6027\u5730\u8BE2\u95EE\uFF09\uFF1A\u54F2\u5B66\u5BB6\uFF1F"
      - "\u7532\uFF1A\u4EC0\u4E48\uFF1F\uFF08\u8FD9\u4EBA\u56DE\u8FC7\u5934\u6765\u5E26\u7740\u5355\u7EAF\u7684\u7B11\u5BB9\uFF0C\u5C31\u50CF\u662F\u5728\u8BF4\u5F88\u4E50\u610F\u5E2E\u5FD9\u4E00\u6837\uFF0C\u4F60\u5E0C\u671B\u81EA\u5DF1\u7684\u7B11\u5BB9\u770B\u8D77\u6765\u4E5F\u80FD\u50CF\u8FD9\u6837\uFF0C\u4E0D\u8FC7\u4F60\u5E76\u4E0D\u662F\u6765\u5BFB\u6C42\u5E2E\u52A9\u7684\uFF0C\u8BF4\u5230\u5E95\uFF0C\u8FD9\u4E5F\u4E0D\u50CF\u4E00\u4E2A\u54F2\u5B66\u5BB6\u7684\u7B11\u5BB9\uFF09"
      - "\u4F60\uFF1A\u4F60\u662F\uFF0C\u54F2\u5B66\u5BB6\u5417\uFF1F"
      - "\u7532\uFF1A\u54C8\u54C8\uFF0C\u60A8\u771F\u6709\u8DA3\uFF0C\u6211\u770B\u8D77\u6765\u50CF\u54F2\u5B66\u5BB6\u5417\uFF1F\uFF08\u5979\u62FF\u624B\u8098\u78B0\u4E86\u78B0\u5DE6\u8FB9\u7684\u5C0F\u5B69\uFF09\u8981\u4E0D\u662F\u4E3A\u4E86\u8FD9\u5B69\u5B50\uFF0C\u6211\u53EF\u4E0D\u4F1A\u65E0\u804A\u63A5\u6536\u8FD9\u4E9B\u9AD8\u96C5\u827A\u672F\u3002\u60A8\u60F3\u5FC5\u662F\u97F3\u4E50\u7684\u884C\u5BB6\u91CC\u624B\u5427\u2026\u2026"
      - "\uFF08\u5B69\u5B50\u9762\u65E0\u8868\u60C5\uFF0C\u9759\u6084\u6084\u5730\u5750\u7740\u4E0D\u52A8\uFF0C\u773C\u955C\u8FB9\u6846\u4E0A\u7FFB\u6D8C\u7740\u9752\u8272\u9EC4\u8272\u7684\u5149\u7EBF\uFF09"
      - "\u65C1\u767D\uFF1A\u4F60\u60F3\u5632\u7B11\u5979\u5BF9\u5427\uFF0C\u4F60\u5DF2\u7ECF\u770B\u89C1\u4E86\u5632\u7B11\u5979\u7684\u5B69\u5B50\u4E86\u4E0D\u662F\u5417\uFF0C\u4F60\u770B\u89C1\u4E86\uFF0C\u6DF9\u6CA1\u5728\u9EBB\u9189\u5242\u91CC\u9762\uFF0C\u62BD\u6410\u7684\u77DB\u76FE\uFF0C\u5BF9\u5427\uFF0C\u5C31\u50CF\uFF0C\u955C\u5B50\u4E00\u6837\u3002\u4ED6\u4EEC\u4E0D\u53EF\u80FD\u7231\u76F8\u540C\u7684\u4E1C\u897F\uFF0C\u8FD9\u5C31\u5BF9\u5566\uFF0C\u4E16\u754C\u5728\u4F60\u773C\u91CC\u5C31\u8BE5\u662F\u8FD9\u4E48\u5730\u2026\u2026\u4F60\u7B11\u4E86\uFF0C\u800C\u4E14\u6B63\u597D\u5408\u4E4E\u793C\u8C8C\u3002"
      - "\uFF08\u638C\u58F0\u54CD\u8D77\uFF0C\u4E50\u56E2\u5F00\u59CB\u5165\u573A\uFF0C\u4F60\u4EEC\u95ED\u4E0A\u4E86\u5634\uFF09"
    - id: AudienceB
      lines:
      - "\u4F60\uFF1A\uFF08\u5C0F\u58F0\uFF09\u60A8\u4E00\u5B9A\u662F\u54F2\u5B66\u5BB6\u5427\uFF1F"
      - "\u4E59\uFF1A\u54E6\u4E0D\u4E0D\u4E0D\uFF0C\u60A8\u8BA4\u9519\u4EBA\u4E86\u5427\uFF0C\u6211\u53EA\u662F\u6765\u542C\u70ED\u95F9\u7684\u3002"
      - "\u4F60\uFF1A\u6709\u4EBA\u8BA9\u6211\u5728\u8FD9\u91CC\u627E\u627E\u54F2\u5B66\u5BB6\u6765\u7740\uFF0C\u4E0D\u597D\u610F\u601D\uFF0C\u6253\u6270\u4E86\u3002"
      - "\u4E59\uFF1A\u8FD9\u4E48\u8BF4\uFF0C\u6211\u5728\u60A8\u773C\u91CC\u8FD8\u7B97\u4E2A\u4F53\u9762\u4EBA\u4E86\uFF0C\u54C8\u54C8\uFF0C\u771F\u662F\u62AC\u4E3E\u6211\u4E86\uFF0C\u6211\u8001\u4F34\u8FD8\u5E38\u5E38\u5ACC\u6211\u592A\u8001\u5B9E\u4E86\u3002"
      - "\u4F60\uFF1A\u60A8\u8001\u4F34\uFF1F"
      - "\u4E59\uFF1A\u8BF4\u6765\u8BA9\u60A8\u89C1\u7B11\u4E86\uFF0C\u5979\u4ECA\u5929\u8981\u767B\u53F0\u6F14\u51FA\uFF0C\u5728\u5BB6\u952F\u4E86\u51E0\u4E2A\u6708\u5E8A\u817F\uFF0C\u4E5F\u4E0D\u77E5\u9053\u600E\u4E48\u7684\u5C31\u88AB\u9009\u4E0A\u4E86\uFF0C\u8FD8\u4E0D\u613F\u610F\u6211\u6765\u542C\u5462\uFF0C\u8BF4\u662F\u6D6A\u8D39\u94B1\u2026\u2026"
      - "\u65C1\u767D\uFF1A\u4F60\u53C8\u5F00\u59CB\u8BA8\u538C\u81EA\u5DF1\u4E86\u3002"
      - "\u653E\u5FC3\uFF0C\u4F60\u662F\u9003\u4E0D\u51FA\u53BB\u7684\u3002"
      - "\u4F60\u5E38\u5E38\u89C9\u5F97\uFF0C\u4F60\u662F\u4E2A\u7AD9\u5728\u81EA\u5DF1\u7684\u4F53\u5185\u76D1\u89C6\u81EA\u5DF1\u7684\u4EBA\uFF0C\u4F60\u6709\u8FD9\u79CD\u88AB\u5F3A\u52A0\u7684\u8D23\u4EFB\u3002"
      - "\u4F60\u50CF\u5728\u9ED1\u591C\u91CC\u65C1\u89C2\u4E00\u5927\u56E2\u718A\u718A\u71C3\u70E7\u7684\u7329\u7EA2\u7BDD\u706B\u4E00\u6837\uFF0C\u9ED8\u9ED8\u4E0D\u8BED\u5730\u9762\u5BF9\u7740\u81EA\u5DF1\u7684\u80CC\u5FB7\u611F\u3002"
      - "\u4F60\u521A\u521A\u5728\u60F3\uFF0C\u8FD9\u79CD\u60C5\u611F\u771F\u631A\u7684\u8001\u4EBA\u6253\u9020\u51FA\u6765\u7684\u827A\u672F\u6280\u827A\uFF0C\u4E5F\u53EA\u4E0D\u8FC7\u662F\u5145\u6EE1\u7455\u75B5\u7684\u52A3\u7B49\u54C1\u5417\uFF1F\u4F60\u63E3\u6469\u90A3\u4E2A\u8001\u5987\u4EBA\u6B23\u559C\u82E5\u72C2\u5730\u5728\u8FD9\u79CD\u4E34\u65F6\u7EC4\u5EFA\u7684\uFF0C\u6C34\u5E73\u4F4E\u4E0B\u7684\u4E50\u56E2\u91CC\u53D1\u6325\u81EA\u5DF1\u7684\u60F3\u8C61\u529B\u2026\u2026\u5BF9\u5427\uFF0C\u4F60\u5C31\u7518\u613F\u770B\u5230\u4E11\u6076\u7684\u90A3\u4E00\u9762\uFF0C\u4F60\u5C31\u7518\u613F\u62DC\u5012\u5728\u4E16\u754C\u7684\u51B7\u6F20\u4E4B\u88D9\u4E0B\uFF0C\u53C8\u6709\u8C01\u80FD\u5FCD\u4F4F\u4E0D\u53BB\u618E\u6068\u8FD9\u79CD\u53F9\u606F\u4E0A\u763E\u7684\u81EA\u6211\u5462\uFF1F"
      - "\u4F60\u88C5\u51FA\u6765\u7684\u6BCF\u4E00\u79D2\u7684\u5E73\u9759\uFF0C\u7B80\u76F4\u90FD\u662F\u5947\u8FF9\u3002"
      - "\u4F60\u8FD8\u53EF\u4EE5\u60F3\u8C61\u51FA\u4E00\u4E2A\u66B4\u6012\u5486\u54EE\u7684\u81EA\u5DF1\uFF0C\u8C22\u5929\u8C22\u5730\u3002"
      - "\u5982\u679C\u4F60\u6D3B\u5230\u8FD9\u4E2A\u5927\u80E1\u5B50\u8001\u6C49\u7684\u5E74\u7EAA\uFF0C\u4E8B\u60C5\u4F1A\u6076\u5316\u5230\u4EC0\u4E48\u7A0B\u5EA6\u5462\uFF1F"
      - "\u4F60\u7684\u6050\u60E7\u548C\u5BD2\u51B7\u4E2D\u7684\u98A4\u6296\u5171\u632F\u7740\uFF0C\u8F89\u714C\u7684\u81EA\u5351\u548C\u5931\u671B\u6269\u6563\u5230\u4E16\u754C\u4E2D\uFF0C\u4E00\u9762\u9762\u955C\u5B50\u88AB\u6253\u788E\u3002\u4F60\u662F\u201C\u88AB\u7981\u6B62\u201D\u7684\uFF0C\u4F60\u90A3\u201C\u88AB\u7981\u6B62\u201D\u7684\u54C0\u4F24\uFF0C\u65E9\u5C31\u50CF\u9ECF\u83CC\u4E00\u6837\uFF0C\u5728\u4E16\u754C\u51DD\u56FA\u9759\u6B62\u7684\u51B0\u9762\u4E0B\uFF0C\u75AF\u72C2\u5730\u62BD\u5F00\u7EC6\u5BC6\u7684\u4E1D\u7EBF\uFF0C\u586B\u6EE1\uFF0C\u593A\u53D6\u4E86\u4F60\u7684\u6574\u4E2A\u8EAB\u4F53\u2026\u2026\u8DDD\u79BB\u4F60\u5F00\u59CB\u5C1D\u8BD5\u8BA4\u8BC6\u4E00\u5207\u4E4B\u540E\uFF0C\u4E0D\u8FC7\u82B1\u4E86\u77ED\u77ED\u4E8C\u5341\u51E0\u5E74\u800C\u5DF2\u3002"
      - "\u4F60\uFF1A\u60A8\u771F\u662F\u4E2A\u5E78\u798F\u7684\u4EBA\u554A\uFF0C\u795D\u60A8\u5728\u6F14\u51FA\u4E2D\u542C\u5F97\u6109\u5FEB\u3002\uFF08\u4F60\u5E76\u6CA1\u6709\u7EE7\u7EED\u7EC6\u542C\u8001\u4EBA\u8BB2\u8BDD\u7684\u5E95\u6C14\uFF0C\u62D2\u7EDD\u6E29\u6696\u7684\u53EF\u80FD\u5BF9\u4F60\u6765\u8BF4\u53CD\u5012\u50CF\u662F\u5173\u4E0A\u51B0\u7BB1\u95E8\u4E00\u6837\u3002\u53EA\u8981\u4F60\u5904\u5728\u4E00\u4E2A\u5982\u4F60\u6240\u613F\u7684\u7EDD\u671B\u4E16\u754C\u4E2D\uFF0C\u5C31\u6CA1\u6709\u4EC0\u4E48\u80FD\u591F\u6253\u788E\u4F60\u5254\u900F\u7684\u81EA\u604B\u3002\u4F60\u7684\u8BED\u6C14\u51E0\u4E4E\u54AC\u7259\u5207\u9F7F\uFF0C\u90A3\u4E2A\u5806\u7B11\u7B80\u76F4\u50CF\u662F\u541E\u4E0B\u4E86\u4E00\u56E2\u53A8\u4F59\u5783\u573E\u2026\u2026\uFF09"
      - "\uFF08\u638C\u58F0\u54CD\u8D77\uFF0C\u4E50\u56E2\u5F00\u59CB\u5165\u573A\uFF0C\u4F46\u4F60\u4EEC\u65E9\u5DF2\u9677\u5165\u65E0\u8BDD\u53EF\u8BF4\u4F46\u53C8\u6682\u65F6\u65E0\u6CD5\u5206\u79BB\u7684\u5C34\u5C2C\u4E2D\uFF0C\u4E0D\uFF0C\u53EA\u6709\u4F60\u4E00\u4E2A\u4EBA\u8FD9\u6837\u800C\u5DF2\uFF09"
    - id: AudienceC
      lines:
      - "\u4F60\uFF1A\uFF08\u5583\u5583\u81EA\u8BED\uFF09\u5982\u679C\u5E0C\u671B\u90FD\u4E0D\u80FD\u5E2E\u5230\u4E00\u4E2A\u9752\u6625\u671F\u7684\u5973\u5B69\uFF0C\u90A3\u4E48\u54F2\u5B66\u5BB6\u4E5F\u4E0D\u80FD\u3002"
      - "\u524D\u6392\u7684\u4EBA\uFF1A\uFF08\u626D\u8FC7\u5934\u770B\u4E86\u4F60\u4E00\u773C\uFF09"
      - "\u4F60\uFF1A\uFF08\u5E76\u4E0D\u754F\u60E7\u8FD9\u6B21\u773C\u795E\u63A5\u89E6\uFF0C\u90A3\u770B\u8D77\u6765\u662F\u4E2A\u75B2\u60EB\u7684\u4EBA\uFF0C\u56E0\u4E3A\u8FD9\u79CD\u75B2\u60EB\uFF0C\u4F60\u89C9\u5F97\u4F60\u4EEC\u5F88\u50CF\uFF0C\u751A\u81F3\uFF0C\u4F60\u89C9\u5F97\u90A3\u4EBA\u6709\u4E00\u79CD\uFF0C\u5F88\u8D81\u624B\u7684\u638C\u63A7\u611F\u2026\u2026\u8FB1\u9A82\u81EA\u5DF1\u4E24\u53E5\uFF0C\u7D27\u63A5\u7740\u5C31\u5982\u540C\u88AB\u7279\u522B\u8C41\u514D\u4E00\u6837\uFF0C\u53BB\u505A\u7F6A\u6076\u7684\u4E8B\u60C5\uFF0C\u771F\u6709\u4F60\u7684\u3002\uFF09\u4F60\u6709\u5F02\u8BAE\u5417\uFF1F"
      - "\uFF08C\u8138\u8272\u4E0D\u592A\u597D\uFF0C\u4F4E\u4E0B\u773C\u775B\uFF0C\u8F7B\u8F7B\u6447\u4E86\u4E00\u4E0B\u5934\uFF0C\u968F\u5373\u5C31\u628A\u8EAB\u5B50\u8F6C\u4E86\u56DE\u53BB\uFF09"
      - "\u4F60\uFF1A\u4E00\u822C\u4EBA\u542C\u5230\u964C\u751F\u7684\u8BF4\u8BDD\u58F0\uFF0C\u591A\u534A\u53EA\u4F1A\u9009\u62E9\u57CB\u4E0B\u5934\u88C5\u4F5C\u6CA1\u6CE8\u610F\u5230\uFF0C\u7136\u540E\u5174\u594B\u5730\u60F3\u8981\u5077\u5077\u518D\u542C\u6E05\u4E24\u53E5\u5427\u3002\u201C\u9752\u6625\u671F\u201D\u2014\u2014\uFF08\u4F60\u8FDF\u7591\u4E86\u4E00\u4F1A\u513F\uFF0C\u6B8B\u5B58\u7684\u5370\u8C61\u4E2D\uFF0C\u524D\u6392\u8FD9\u4EBA\u7684\u9762\u5B54\u4F3C\u4E4E\u8BA9\u4F60\u96BE\u4EE5\u5224\u65AD\u6027\u522B\uFF0C\u4E8E\u662F\u201C\u5973\u5B69\u201D\u4F60\u6CA1\u6709\u8BF4\u5F97\u51FA\u53E3\uFF09\u201C\u54F2\u5B66\u5BB6\u201D\uFF1F\u5BF9\u54EA\u4E2A\u8BCD\u8BED\u4EA7\u751F\u4E86\u7279\u522B\u7684\u5174\u8DA3\u5462\uFF1F"
      - "\uFF08\u542C\u5230\u201C\u54F2\u5B66\u5BB6\u201D\u8FD9\u4E2A\u8BCD\u7684\u65F6\u5019\uFF0C\u90A3\u4EBA\u8EAB\u4F53\u5FAE\u5FAE\u6296\u52A8\u4E86\u4E00\u4E0B\uFF0C\u867D\u7136\u9694\u7740\u5EA7\u6905\u9760\u80CC\uFF0C\u4F60\u53EA\u770B\u5230\u90A3\u4EBA\u7684\u81EA\u5236\u529B\u50CF\u521A\u521A\u98DE\u8D70\u4E86\u9EBB\u96C0\u7684\u6811\u679D\u4E00\u6837\u5F88\u8F7B\u5730\u6447\u6643\u7247\u523B\uFF0C\u4F46\u662F\u4F60\u5F88\u6E05\u695A\u8FD9\u79CD\u8868\u8C61\u80CC\u540E\uFF0C\u5BD2\u98A4\u4E00\u8DEF\u5760\u8FDB\u7075\u9B42\u6DF1\u5904\uFF0C\u649E\u5728\u5FC3\u58C1\u4E0A\uFF0C\u65E0\u53EF\u6291\u5236\u5730\u8FF8\u6E85\u51FA\u6298\u78E8\u4EBA\u7684\u91D1\u77F3\u76F8\u9E23\u58F0\u3002\uFF09"
      - "\u4F60\uFF1A\u8FD9\u4F4D\u2014\u2014\u670B\u53CB\uFF0C\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u5E76\u6CA1\u6709\u6076\u610F\uFF08\u4F60\u63A2\u51FA\u8EAB\u5B50\uFF0C\u624B\u642D\u5728\u524D\u4E00\u6392\u7684\u9760\u80CC\u4E0A\uFF09\uFF0C\u53EA\u4E0D\u8FC7\u78B0\u5230\u4E86\u4E00\u70B9\u70E6\u5FC3\u4E8B\uFF0C\u6BD4\u5982\uFF0C\u6709\u4E2A\u5973\u751F\u7740\u6025\u5FD9\u614C\u5730\u6253\u7535\u8BDD\u6765\u8981\u6211\u627E\u627E\u4E00\u4E2A\u53EB\u201C\u54F2\u5B66\u5BB6\u201D\u7684\u4EBA\uFF08\u8FD8\u6709\u7A81\u7136\u641E\u4E22\u4E86\u8BB0\u5FC6\uFF0C\u4E0D\u8FC7\u4F60\u5C45\u7136\u5BF9\u6B64\u4E91\u6DE1\u98CE\u8F7B\uFF09\uFF0C\u542C\u5979\u8BED\u6C14\u8FD8\u633A\u90D1\u91CD\u5176\u4E8B\u7684\uFF0C\u73B0\u5728\u4E00\u60F3\uFF0C\u8FD9\u641E\u4E0D\u597D\u662F\u4E2A\u6076\u4F5C\u5267\u5450\u3002"
      - "\uFF08\u4F60\u8FD8\u60F3\u4E71\u4E03\u516B\u7CDF\u8BF4\u4E9B\u4EC0\u4E48\uFF09"
      - "C\uFF1A\u5979\u8BF4\u8BA9\u4F60\u627E\u53EB\u505A\u54F2\u5B66\u5BB6\u7684\u4EBA\u5417\uFF1F\u5979\u8FD8\u8BF4\u4EC0\u4E48\u4E86\uFF1F\uFF08\u8FD9\u4EBA\u7ACB\u523B\u63D2\u5165\u4E86\u4F60\u8BF4\u8BDD\u601D\u8003\u7684\u77ED\u6682\u505C\u987F\uFF0C\u76B1\u7740\u7709\u5934\u76EF\u7740\u4F60\uFF09"
      - "\u65C1\u767D\uFF1A\u54C8\u54C8\u54C8\uFF0C\u6CA1\u60F3\u5230\u771F\u7684\u88AB\u4F60\u649E\u4E0A\u4E86\uFF0C\u600E\u4E48\u6837\uFF0C\u4F60\u6253\u7B97\u600E\u4E48\u505A\uFF1F\u4E45\u8FDD\u5730\u5C1D\u5C1D\u770B\uFF0C\u52A9\u4EBA\u4E3A\u4E50\u5473\u513F\u7684\uFF0C\u81EA\u604B\uFF1F"
      - "\u4F60\u4EEC\u4FE9\u7684\u6027\u683C\u4E00\u671B\u800C\u77E5\u5730\u4E0D\u548C\uFF0C\u4F46\u662F\uFF0C\u4F60\u4E0D\u6562\u4E8E\u627F\u62C5\u51B2\u7A81\uFF0C\u6BD5\u7ADF\u53EA\u8981\u5728\u5F15\u7EBF\u5FEB\u8981\u71C3\u5C3D\u7684\u65F6\u5019\uFF0C\u4F60\u5C31\u53EF\u4EE5\u7529\u51FA\u4F60\u7684\u62FF\u624B\u597D\u620F\u4E86\uFF0C\u201C\u6211\u771F\u8BA8\u538C\u81EA\u5DF1\u201D\uFF0C\u6216\u8005\uFF1A\u201C\u8FD9\u4E48\u505A\uFF0C\u6211\u4E5F\u5F88\u75DB\u82E6\u201D\uFF0C\u6216\u8005\uFF1A\u201C\u4F60\u7684\u8C34\u8D23\u5168\u90FD\u6709\u7406\u6709\u636E\uFF0C\u6211\u53D7\u5230\u5904\u7F5A\u5176\u5B9E\u4E5F\u5FC3\u7518\u60C5\u613F\u201D\uFF0C\u5F53\u4F53\u5185\u90A3\u4E2A\u5531\u53CC\u7C27\u7684\u76D1\u89C6\u8005\u7AD9\u51FA\u6765\uFF0C\u5F53\u4F60\u4E5F\u4E34\u9635\u5012\u6208\u9644\u548C\u522B\u4EBA\uFF0C\u5E0C\u671B\u6BC1\u706D\u81EA\u5DF1\u7684\u65F6\u5019\uFF0C\u4E0D\u5C31\u80FD\u591F\u514D\u4E8E\u627F\u62C5\u4E00\u5207\u8D23\u4EFB\u4E86\u5417\uFF1F"
      - "\u4F46\u662F\u773C\u4E0B\u7684\u7A0B\u5EA6\u4F3C\u4E4E\u4E5F\u8FD8\u4E0D\u81F3\u4E8E\u505A\u5230\u90A3\u6837\u2026\u2026"
      - "\u4F60\uFF1A\u867D\u7136\u6211\u4E5F\u4E0D\u77E5\u9053\u90A3\u5973\u5B69\u4E3A\u4EC0\u4E48\u8981\u628A\u4F60\u53EB\u505A\u54F2\u5B66\u5BB6\uFF0C\u4F46\u662F\u4F60\u5927\u6982\u542C\u5F97\u61C2\u8FD9\u53E5\u8BDD\u5427\uFF1A\u201C\u540E\u95E8\u7684\u2026\u2026\u706B\u82D7\uFF0C\u5C31\u8981\u7184\u706D\u4E86\u3002\u201D"
      - "C\uFF1A\uFF08\u8138\u5E9E\u95EA\u8FC7\u4E00\u4E1D\u4E0D\u89E3\uFF09\u4EC0\u4E48\uFF0C\u706B\u82D7\uFF1F\u662F\u8C01\u8BA9\u4F60\u5E26\u8BDD\u7684\uFF1F"
      - "\uFF08\u5979\u8BF4\u8BDD\u7684\u5C3E\u97F3\u8BA9\u4F60\u8BA4\u6E05\u4E86\u8FD9\u662F\u4E2A\u5973\u5B69\uFF09"
      - "\u4F60\uFF1A\u6211\u4E5F\u8BB0\u4E0D\u6E05\u548C\u5979\u4E0A\u6B21\u89C1\u9762\u662F\u4EC0\u4E48\u65F6\u5019\u4E86\uFF0C\u6240\u4EE5\u4F60\u627F\u8BA4\u81EA\u5DF1\u662F\u54F2\u5B66\u5BB6\u54AF\uFF1F\u4F60\u4EEC\u662F\u540C\u5B66\u3001\u670B\u53CB\uFF1F"
      - "C\uFF1A\u6211\u53EF\u5F97\u7EA0\u6B63\u4F60\uFF0C\u5979\u4ECE\u6765\u6CA1\u53EB\u8FC7\u6211\u54F2\u5B66\u5BB6\uFF0C\u8FD9\u662F\u2026\u2026\u8FD9\u4E0D\u5173\u4F60\u7684\u4E8B\u2026\u2026\u4F60\u4EEC\u4E24\u4E2A\u4E4B\u95F4\u662F\u4EC0\u4E48\u5173\u7CFB\uFF1F"
      - "\uFF08\u5267\u9662\u5927\u5385\u548C\u8FC7\u9053\u7684\u706F\u5149\u7A81\u7136\u6697\u4E0B\u6765\uFF0C\u53EA\u5269\u4E0B\u821E\u53F0\u4E0A\u660E\u4EAE\u70AB\u76EE\u7684\u5C04\u706F\uFF0C\u91D1\u9EC4\u7684\u5149\u6655\u4EFF\u4F5B\u4ECE\u5979\u80CC\u540E\u6DF1\u8FDC\u7684\u5730\u65B9\u201C\u54D7\u201D\u5730\u4E00\u58F0\u7167\u6765\uFF0C\u5979\u7684\u8EAB\u5F62\u8F6E\u5ED3\u5982\u540C\u77AC\u95F4\u76D6\u4E0A\u4E86\u4E00\u5F20\u7EA4\u7EC6\u67D4\u548C\u7684\u7ED2\u6BDB\u6BEF\uFF0C\u8FD9\u7A81\u5982\u5176\u6765\u7684\u666F\u8C61\u8BA9\u4F60\u60F3\u5230\u4E86\u6E5B\u84DD\u7684\u6D77\u9762\u4E0A\u7A81\u7136\u522E\u8D77\u7684\u65CB\u98CE\uFF0C\u5904\u5728\u8FD9\u79CD\u65F6\u523B\uFF0C\u4E00\u4E2A\u4EBA\u4EFF\u4F5B\u5C31\u80FD\u575A\u4FE1\u81EA\u5DF1\u5185\u5FC3\u7684\u4E07\u91CC\u65E0\u4E91\u2026\u2026\uFF09"
      - "\u4F60\uFF1A\uFF08\u4E00\u65F6\u60CA\u8BB6\u5730\u6709\u4E9B\u8BF4\u4E0D\u51FA\u8BDD\u6765\uFF09\u989D\uFF0C\u5927\u6982\u5C31\u662F\u4E92\u76F8\u5B58\u7684\u6709\u7535\u8BDD\u53F7\u7801\u7684\u5173\u7CFB\u561B\uFF0C\u4E0D\u8FC7\u6211\u5176\u5B9E\u5BF9\u5979\u6CA1\u4EC0\u4E48\u5370\u8C61\u4E86\u3002"
      - "\u54F2\u5B66\u5BB6\uFF1A\u6240\u4EE5\u5979\u751A\u81F3\u4F1A\u8BF7\u6C42\u4F60\u8FD9\u79CD\u4EBA\u5E2E\u5FD9\u5417\uFF1F"
      - "\u4F60\uFF1A\u5979\u53EF\u6CA1\u6709\u8BF7\u6C42\u6211\uFF0C\u5979\u5F3A\u88C5\u7740\u4E16\u754C\u4E0A\u6CA1\u6709\u80FD\u591F\u8BA9\u5979\u754F\u60E7\u7684\u4E1C\u897F\uFF0C\u8F7B\u98D8\u98D8\u5730\u8BF4\u7740\u4E00\u5207\u968F\u6211\u7684\u5FC3\u60C5\u554A\uFF0C\u770B\u6765\u6211\u7684\u5FC3\u60C5\u2014\u2014\u5176\u5B9E\u5F88\u4E0D\u9519\uFF1F"
      - "\u54F2\u5B66\u5BB6\uFF1A\u5173\u4E8E\u95E8\u53E3\u3001\u706B\u82D7\u7684\u90A3\u53E5\u8BDD\uFF0C\u5979\u6709\u89E3\u91CA\u5417\uFF1F"
    - id: C0
      lines:
      - "\u4F60\uFF1A\u5979\u8BF4\u4F60\u5E94\u8BE5\u61C2\u5F97\u554A\uFF0C\u6211\u4EEC\u8BE5\u4E0D\u662F\u4E92\u76F8\u8BEF\u4F1A\u8BA4\u9519\u4EBA\u4E86\u5427\uFF0C\u5662\u4E0D\uFF0C\u4F60\u4EEC\u4E24\u4E2A\u7ECF\u7531\u6211\u4E92\u76F8\u8BEF\u8BA4\u4E86\u3002"
      - "\u54F2\u5B66\u5BB6\uFF1A\u5979\u5728\u627E\u4EBA\uFF0C\u800C\u6211\u4E5F\u5728\u7B49\u4EBA\u2026\u2026\u5176\u5B9E\u5927\u6982\u7387\u662F\u771F\u7684\u3002"
      - "\u4F60\uFF1A\u771F\u5047\u4F3C\u4E4E\u4E0D\u90A3\u4E48\u91CD\u8981\u561B\u3002\u5C31\u50CF\u5173\u4E8E\u706B\u5149\u90A3\u53E5\u8BDD\uFF0C\u5979\u89E3\u91CA\u4E3A\u5E0C\u671B\u7684\u6D88\u5931\u4E4B\u7C7B\u7684\uFF0C\u8FD8\u8BF4\u4E0D\u9700\u8981\u5E0C\u671B\uFF0C\u53EA\u7528\u76F8\u4FE1\u3002\u5979\u90A3\u4E48\u76F8\u4FE1\u8C1C\u8BED\u4E00\u5B9A\u4F1A\u88AB\u89E3\u5F00\uFF0C\u770B\u6765\u4E5F\u8981\u5931\u671B\u4E86\u554A\u3002\uFF08\u4F60\u603B\u662F\u5FCD\u4E0D\u4F4F\u8981\u628A\u8FD9\u540E\u4E00\u53E5\u8BF4\u51FA\u6765\uFF09"
      - "\u54F2\u5B66\u5BB6\uFF1A\u76F8\u4FE1\u5417\uFF1F\u6211\uFF0C\u786E\u5B9E\u662F\u8BA9\u5979\u5931\u671B\u4E86\u5440\u3002"
      - "\uFF08\u4E00\u4E2A\u8FDF\u5230\u8FDB\u573A\u7684\u7537\u4EBA\u5306\u5306\u5FD9\u5FD9\u7A7F\u8FC7\u697C\u68AF\u843D\u5EA7\u5728\u4E0D\u8FDC\u5904\uFF0C\u4ED6\u7B28\u62D9\u5730\u6324\u8FC7\u5EA7\u6905\u65F6\uFF0C\u63D0\u7740\u7684\u5305\u88F9\u88C5\u6765\u649E\u53BB\uFF0C\u4F60\u5FCD\u4E0D\u4F4F\u8F7B\u8511\u5730\u51B7\u54FC\u4E86\u4E00\u58F0\uFF0C\u5979\u5374\u671B\u7740\u8FD9\u4E2A\u8DCC\u8DCC\u649E\u649E\u4E00\u8DEF\u7ECF\u8FC7\u773C\u524D\u7684\u4EBA\u82E5\u6709\u6240\u601D\uFF09"
      - "\u4F60\uFF1A\u4F60\u5BF9\u97F3\u4E50\u5F88\u611F\u5174\u8DA3\u5417\uFF1F\u4E00\u4E2A\u4EBA\u4E5F\u8981\u6765\u542C\u3002"
      - "\u54F2\u5B66\u5BB6\uFF1A\u5174\u8DA3\u4E00\u822C\uFF0C\u6211\u672C\u6765\u4E0D\u662F\u4E3A\u4E86\u81EA\u5DF1\u6765\u5230\u8FD9\u91CC\u7684\u2026\u2026\u90A3\u4E2A\uFF0C\u8BF7\u95EE\u6211\u80FD\u501F\u60A8\u7684\u624B\u673A\u7ED9\u5979\u56DE\u62E8\u5417\uFF1F"
      - "\uFF08\u597D\u5427\uFF0C\u81F3\u5C11\u4F60\u7684\u65E0\u836F\u53EF\u6551\u4E0D\u5C51\u4E8E\u901A\u8FC7\u8FD9\u4E48\u6D45\u663E\u7684\u65B9\u5F0F\u8868\u9732\uFF0C\u4F60\u7ED5\u8FC7\u4E86\u4E00\u5927\u5708\uFF0C\u5012\u662F\u8FD8\u5728\u6697\u6697\u671F\u5F85\u7740\u52A9\u4EBA\u4E3A\u4E50\u561B\u3002\uFF09"
      - "\uFF08\u4F60\u7FFB\u51FA\u6765\u7535\u53F7\u7801\uFF0C\u628A\u624B\u673A\u4EA4\u7ED9\u4E86\u5979\uFF09"
      - "\uFF08\u5979\u7684\u624B\u6307\u4E0A\u6709\u521B\u53EF\u8D34\uFF09"
      - "\u2026\u2026"
      - "\u54F2\u5B66\u5BB6\uFF1A\u90A3\u4F3C\u4E4E\u662F\u4E2A\u516C\u5171\u7535\u8BDD\u4EAD\u3002\uFF08\u5979\u628A\u624B\u673A\u9012\u4E86\u56DE\u6765\uFF09\u8C22\u8C22\u4F60\u3002\uFF08\u5FAE\u7B11\uFF0C\u4F4E\u5934\uFF0C\u843D\u5BDE\uFF0C\u5F97\u4F53\u3002\u5979\u8FD9\u53E5\u8BDD\u7684\u8BED\u6C14\u542C\u8D77\u6765\u5927\u4E8E\u7B49\u4E8E\u57FA\u672C\u793C\u8C8C\uFF0C\u5C31\u50CF\u97F3\u4E50\u4E00\u6837\u3002\uFF09"
      - "\u4F60\uFF1A\uFF08\u611F\u5230\u83AB\u540D\u88AB\u7F9E\u8FB1\u4E86\u4E00\u987F\uFF0C\u5728\u8FD9\u5177\u964C\u751F\u53C8\u719F\u6089\u7684\u8EAB\u4F53\u91CC\uFF0C\u4F60\u5FFD\u7136\u89C9\u5F97\u8981\u662F\u81EA\u5DF1\u4E00\u70B9\u5FD9\u90FD\u5E2E\u4E0D\u4E0A\uFF0C\u90A3\u771F\u662F\u4E0D\u53EF\u5BB9\u5FCD\u3002\uFF09\u4F60\u9700\u8981\u94B1\u5417\uFF1F"
      - "\uFF08\u4F60\u6253\u5F00\u94B1\u5305\u638F\u4E86\u4E00\u4E9B\u5185\u5BB9\u51FA\u6765\uFF09"
      - "\u54F2\u5B66\u5BB6\uFF1A\uFF08\u9519\u6115\u76B1\u8D77\u7709\u5934\uFF09\u4E0D\uFF0C\u4E0D\uFF0C\u60A8\u548C\u672A\u547D\u540D\u4E4B\u95F4\u7684\u5173\u7CFB\u5927\u6982\u7684\u786E\u975E\u540C\u4E00\u822C\uFF0C\u6211\u4E0D\u8BE5\u6000\u7591\u8FD9\u70B9\uFF0C\u4F46\u662F\u8FD9\u7EDD\u5BF9\u4E0D\u662F\u6211\u8BE5\u5411\u60A8\u65E0\u7AEF\u7D22\u53D6\u7684\u4F9D\u636E\uFF0C\u800C\u4E14\u6211\u6253\u5FC3\u91CC\u8BA4\u4E3A\uFF0C\u8FD9\u7EDD\u5BF9\u662F\u4E0D\u53EF\u80FD\u771F\u6B63\u5728\u4EFB\u4F55\u7A0B\u5EA6\u4E0A\u5E2E\u5230\u4E00\u4E2A\u4EBA\u7684\u2026\u2026"
      - "\uFF08\u5979\u8D8A\u8BF4\u8D8A\u5FEB\uFF0C\u751A\u81F3\u6709\u4E9B\u751F\u6C14\uFF0C\u4F60\u89C9\u5F97\u81EA\u5DF1\u5728\u90BB\u5EA7\u51E0\u4E2A\u4EBA\u8BB6\u5F02\u7684\u76EE\u5149\u4E2D\u6525\u7740\u4E00\u628A\u949E\u7968\u7B80\u76F4\u662F\u4E2A\u5C0F\u4E11\uFF09"
      - "\uFF08\u5979\u56DE\u8FC7\u5934\u53BB\uFF0C\u4EA4\u53C9\u53CC\u81C2\uFF0C\u8EAB\u5B50\u7F29\u5F97\u7D27\u7D27\u7684\uFF0C\u4E0E\u6B64\u540C\u65F6\uFF0C\u638C\u58F0\u54CD\u8D77\uFF0C\u4E50\u56E2\u5F00\u59CB\u5165\u573A\uFF0C\u4F60\u89C9\u5F97\u540E\u9762\u7684\u6F14\u51FA\u90FD\u662F\u5BF9\u4F60\u7684\u5632\u7B11\u3002\uFF09"
    - id: C1
      lines:
      - "\u4F60\uFF1A\u6211\u5012\u662F\u60F3\u542C\u542C\u4F60\u7684\u89E3\u91CA\uFF0C\u6BD5\u7ADF\u90A3\u4EBA\u8BF4\u4E86\u8BE5\u7531\u4F60\u6765\u89E3\u8C1C\u5440\u3002"
      - "\u54F2\u5B66\u5BB6\uFF1A\u90A3\u6211\u4E00\u65F6\u4E4B\u95F4\u7684\u786E\u8FD8\u6CA1\u6709\u5934\u7EEA\u2026\u2026"
      - "\u4F60\uFF1A\u8BF4\u4E9B\u8BA9\u4EBA\u6478\u4E0D\u7740\u5934\u8111\u7684\u8BDD\uFF0C\u5F53\u771F\u662F\u6C38\u8FDC\u65F6\u9AE6\u7684\u4E8B\u60C5\u554A\uFF0C\u4E0D\u8FC7\u8981\u662F\u50CF\u8001\u5E74\u4EBA\u4E00\u6837\uFF0C\u6BCF\u4E00\u53E5\u8BDD\u90FD\u53EF\u4EE5\u88AB\u63D0\u524D\u9884\u6D4B\uFF0C\u90A3\u53C8\u592A\u65E0\u804A\u4E86\uFF0C\u6240\u4EE5\u5373\u4FBF\u95F9\u51FA\u4E86\u73B0\u5728\u8FD9\u6837\u7684\u7B11\u8BDD\uFF0C\u4E5F\u4E0D\u602A\u4F60\u4EEC\u2014\u2014\u53E4\u5F80\u4ECA\u6765\uFF0C\u4E16\u754C\u4E0A\u7684\u8001\u5E74\u4EBA\u8BF4\u7684\uFF0C\u90FD\u662F\u540C\u4E00\u53E5\u8BDD\u554A\u2026\u2026"
      - "\u54F2\u5B66\u5BB6\uFF1A\u53EA\u4E0D\u8FC7\u662F\u4E22\u5931\u4E86\u52C7\u6C14\u800C\u5DF2\uFF0C\u4F60\u4EEC\u90A3\u4E9B\u8BDD\uFF0C\u6211\u4EEC\u8981\u662F\u60F3\u8BF4\uFF0C\u4E00\u77AC\u95F4\u5C31\u80FD\u5B66\u4F1A\u3002"
      - "\u65C1\u767D\uFF1A\u4F60\u672C\u6765\u628A\u81EA\u5DF1\u5B89\u5B89\u7A33\u7A33\u5730\u653E\u5728\u4E86\u201C\u4F60\u4EEC\u201D\u548C\u201C\u8001\u5E74\u4EBA\u201D\u4E4B\u95F4\uFF0C\u90A3\u4E2A\u53D6\u5DE7\u7684\u4F4D\u7F6E\u4E0A\uFF0C\u6CA1\u60F3\u5230\u8FD9\u5B69\u5B50\u76F4\u63A5\u65E0\u89C6\u4E86\u4F60\u907F\u514D\u8D23\u4EFB\u7684\u63AA\u8F9E\u4E60\u60EF\uFF0C\u8FD9\u5B69\u5B50\u7684\u4E16\u754C\uFF0C\u5B8C\u5168\u662F\u975E\u5206\u660E\u5450\u3002\u4F60\u6CA1\u6CD5\u8FA9\u9A73\uFF0C\u4E0D\u662F\u5417\uFF0C"
      - "\u52C7\u6C14\u662F\u79BB\u4F60\u6700\u9065\u8FDC\u7684\u5929\u4F53\uFF0C\u4F60\u65E9\u5C31\u6CA1\u6709\u4F9D\u9760\u5B83\u5FAE\u5F31\u7684\u5F15\u529B\u8FD0\u8F6C\u4E86\u3002"
      - "\u88AB\u4EBA\u8BF4\u4E2D\u4E4B\u540E\u5347\u8D77\u7684\u65E0\u6BD4\u5BC2\u5BE5\uFF0C\u662F\u4F60\u8D56\u4EE5\u7EF4\u751F\u7684\u751C\u871C\u54C1\u5FB7\u3002"
      - "\u4F60\uFF1A\u201C\u540E\u95E8\u7684\u706B\u82D7\u201D\u2026\u2026\u6211\u73B0\u5728\u5F00\u59CB\u6E29\u4E60\u7684\u8BDD\uFF0C\u7F6A\u759A\u5927\u6982\u4E5F\u6D17\u5237\u4E0D\u5E72\u51C0\u4E86\u5427\u3002"
      - "\u54F2\u5B66\u5BB6\uFF1A\u4E0D\u4ECE\u4F60\u62D0\u5F2F\u62B9\u89D2\u7684\u5B9A\u4E49\u51FA\u53D1\uFF0C\u90A3\u53E5\u8BDD\u5F88\u663E\u7136\u53EA\u662F\u4E00\u4E2A\u7EA6\u5B9A\u6697\u53F7\u561B\u3002"
      - "\u4F60\uFF1A\u6240\u4EE5\u4F60\u5FD8\u8BB0\u4E86\uFF1F"
      - "\u54F2\u5B66\u5BB6\uFF1A\u5927\u6982\u4E5F\u6709\u53EF\u80FD\u56DE\u5FC6\u8D77\u6765\uFF0C\u6211\u6CA1\u6709\u53EF\u4EE5\u76F4\u63A5\u548C\u672A\u547D\u540D\u8BF4\u4E0A\u8BDD\u7684\u8FD0\u6C14\uFF0C\u73B0\u5728\u6211\u53EA\u80FD\u51C6\u5907\u53BB\u8FCE\u63A5\u5FC5\u7136\u7684\u4E8B\u60C5\u4E86\u3002"
      - "\u4F60\uFF1A\u6BD4\u5982\u4E22\u4E0B\u5979\u4E00\u4E2A\u4EBA\u6765\u4EAB\u53D7\u97F3\u4E50\uFF1F"
      - "\u54F2\u5B66\u5BB6\uFF1A\u4F60\u6FC0\u6012\u4E0D\u4E86\u6211\u7684\uFF0C\u6CA1\u6709\u5979\u6211\u662F\u4E0D\u4F1A\u6765\u5230\u8FD9\u91CC\u7684\uFF0C\u7B49\u7740\u5427\uFF0C\u641E\u4E0D\u597D\u5979\u4E00\u4F1A\u513F\u53C8\u51FA\u73B0\u4E86\u5462\uFF1F"
      - "\u4F60\uFF1A\u51FA\u73B0\uFF1F\u6253\u4E2A\u7535\u8BDD\u53BB\u95EE\u95EE\u5979\u600E\u4E48\u6837\uFF1F\u62FF\u6211\u7684\u624B\u673A\uFF1F\uFF08\u4F60\u7B80\u76F4\u662F\u5728\u6CA1\u8BDD\u627E\u8BDD\u5730\u54C0\u6C42\uFF09"
      - "\u54F2\u5B66\u5BB6\uFF1A\u4E0D\uFF0C\u6211\u786E\u5B9E\u641E\u5FD8\u4E86\uFF0C\u8FD9\u662F\u6211\u5E94\u8BE5\u8D1F\u8D23\u7684\u4E8B\u60C5\u3002"
      - "\u4F60\uFF1A\u4F60\u4E5F\u5F88\u81EA\u604B\uFF0C\u54C8\u54C8\uFF0C\u4F60\u8981\u7684\u5E76\u4E0D\u662F\u89E3\u51B3\u95EE\u9898\u2026\u2026\uFF08\u4F60\u4E00\u65E6\u6293\u4F4F\u673A\u4F1A\uFF0C\u5C31\u7ACB\u523B\u8DF3\u8D77\u6765\u53CD\u54AC\u4E00\u53E3\uFF0C\u8FD9\u5C31\u662F\u6240\u6709\u54C0\u6C42\u7684\u672C\u8D28\u3002\uFF09"
      - "\u54F2\u5B66\u5BB6\uFF1A\u4F60\u786E\u5B9E\u662F\uFF0C\u5E2E\u4E0D\u5230\u6211\u7684\uFF0C\u6211\u2026\u2026"
      - "\uFF08\u638C\u58F0\u54CD\u8D77\uFF0C\u4E50\u56E2\u5165\u573A\uFF0C\u6253\u65AD\u4E86\u5979\u6709\u4E9B\u52A8\u6447\u7684\u8BDD\u8BED\uFF0C\u800C\u4F60\uFF0C\u5750\u5728\u80DC\u5229\u8005\u7684\u5EA7\u4F4D\u4E0A\uFF0C\u88AB\u81EA\u5DF1\u7684\u6094\u6068\u6298\u78E8\u5F97\u8981\u6B7B\uFF0C\u611F\u89C9\u5982\u4F55\u5462\uFF1F\u53EF\u60DC\u4E86\uFF0C\u8FD8\u6709\u97F3\u4E50\u80FD\u62FF\u6765\u7ED9\u4F60\u5206\u795E\u2026\u2026\uFF09"
    - id: Transition
      lines:
      - "\u201C\u5373\u4F7F\u8FD9\u4E0D\u662F\u771F\u6B63\u7684\u6700\u5B8C\u7F8E\u7684\u73B0\u5B9E\uFF0C\u5374\u662F\u4EE4\u6211\u63EA\u5FC3\u7684\u73B0\u5B9E\u554A\u3002\u201D\u2014\u2014\u5DDD\u7AEF\u5EB7\u6210\u300A\u821E\u59EC\u300B"
